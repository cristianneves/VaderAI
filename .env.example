# Copy to .env and fill in. Never commit .env.
# The desktop app reads none of these — every provider key stays server-side.

# --- Server ---------------------------------------------------------------
SERVER_PORT=8787
# INFO in a deployed environment — this service handles interview transcripts,
# and DEBUG is verbose enough that it does not belong in one. Set it to DEBUG
# locally when you are following a session through the code.
LOG_LEVEL=INFO

# Both provider keys below are required in a deployed environment:
# /actuator/health reports DOWN without them, and the startup log names which
# one is missing. They are allowed to be empty locally and in tests.

# --- Anthropic (Phase 4) --------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Research preview: same model, up to 2.5x output speed, premium pricing,
# Claude API only. Leave false unless you are deliberately paying for it.
ANTHROPIC_FAST_MODE=false
# Override to point the answer engine at a local stand-in during development.
ANTHROPIC_BASE_URL=

# --- Deepgram (Phase 3) ---------------------------------------------------
DEEPGRAM_API_KEY=
# Override to point the STT provider at a local stand-in during development.
DEEPGRAM_URL=wss://api.deepgram.com/v1/listen

# --- Supabase (Phase 3) ---------------------------------------------------
# For the local CLI stack (`pnpm supabase:start`) the defaults in
# application.yml already point at 127.0.0.1 — these are for a cloud project.
# Project ref is the subdomain of your Supabase URL.
SUPABASE_PROJECT_REF=
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Service-role connection. NOTE: this bypasses RLS — every query in the
# service layer must be scoped by the userId taken from the verified JWT.
SUPABASE_DB_URL=jdbc:postgresql://<host>:5432/postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# --- Desktop (build-time) -------------------------------------------------
# Local stack: http://127.0.0.1:54321 and the publishable key printed by
# `pnpm supabase:start`. The anon/publishable key is public by design — RLS is
# what confines a signed-in user to their own rows.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SERVER_WS_URL=ws://localhost:8787/v1/session
# REST side of the same backend; derived from the socket URL when unset.
VITE_SERVER_HTTP_URL=http://localhost:8787

# --- Desktop (production build) -------------------------------------------
# VITE_* values are baked into the bundle at build time, so `pnpm
# package:desktop` produces an installer pinned to whatever is set here. Vite
# reads `.env.production` in preference to `.env` for a production build, so put
# the deployed values in a `.env.production` at this same level — it is
# gitignored — and leave the dev values above alone:
#
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<publishable key from the Supabase dashboard>
#   VITE_SERVER_WS_URL=wss://<your-app>.fly.dev/v1/session
#
# Leave VITE_SERVER_HTTP_URL unset there: it is derived from the socket URL, and
# wss:// correctly yields https://. Setting it by hand is how a release ends up
# posting bearer tokens over plain HTTP.
