{
  "name": "@vaderai/desktop",
  "version": "0.13.0",
  "private": true,
  "//productName": "Electron derives app.getName() — and therefore userData — from productName, falling back to name. Without this the installed app keeps its session and logs under %APPDATA%\\@vaderai\\desktop, a nested directory named after the npm scope.",
  "productName": "VaderAI",
  "description": "VaderAI — real-time interview copilot overlay for Windows",
  "author": "VaderAI",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "package:dir": "electron-vite build && electron-builder --win --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.9",
    "@vaderai/protocol": "workspace:*",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
