{
  "name": "@vaderai/desktop",
  "version": "0.9.0",
  "private": true,
  "//productName": "Electron derives app.getName() — and therefore userData — from productName, falling back to name. Without this the installed app keeps its session and logs under %APPDATA%\\@vaderai\\desktop, a nested directory named after the npm scope.",
  "productName": "VaderAI",
  "description": "VaderAI — real-time interview copilot overlay for Windows",
  "author": "VaderAI",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "package:dir": "electron-vite build && electron-builder --win --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.9",
    "@vaderai/protocol": "workspace:*",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
